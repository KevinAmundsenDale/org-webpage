{
  "name": "org-webpage",
  "version": "1.1.2",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "start": "node server.mjs",
    "dev": "node server.mjs --dev",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "desktop": "npm run build && electron .",
    "desktop:pack": "npm run build && electron-builder --dir --publish never",
    "desktop:dist": "npm run build && electron-builder --publish never",
    "content:build": "node scripts/content-build.mjs",
    "proposal:apply": "node scripts/apply-proposal.mjs",
    "test:sync-browser": "node tests/sync-browser.mjs",
    "test:desktop": "node tests/desktop.mjs"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "d3": "^7.9.0",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2"
  },
  "description": "Et fagkart for organisasjon, ledelse og etikk",
  "author": "Kevin Amundsen Dale",
  "main": "desktop/main.cjs"
}
